 describe("a new harness session that shares the first user message", () => {
+  it("isolates growing histories from different explicit client sessions", () => {
+    const pool = new SessionPool();
+    const opener = [{ role: "user" as const, content: "Inspect this project." }];
+    const first = pool.resolve(opener, undefined, "client-one");
+    first.sentMessageCount = 1;
